{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/docs/research/**", "$TURBO_ROOT$/research/colab/makata-baselines.ipynb", "$TURBO_ROOT$/research/colab/makata-qlora-full.ipynb", "$TURBO_ROOT$/research/colab/makata-post-training.ipynb"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "public/research-materials/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
